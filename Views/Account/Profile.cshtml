@model ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Customer profile</p>
        <h1 class="page-title">@Model.User.FullName</h1>
    </div>
</section>

<section class="container py-4">
    <div class="row g-4">
        <div class="col-lg-4">
            <aside class="summary-panel">
                <h2>Account details</h2>
                <div class="summary-line">
                    <span>Email</span>
                    <strong>@Model.User.Email</strong>
                </div>
                <div class="summary-line">
                    <span>Phone</span>
                    <strong>@(Model.User.Phone ?? "Not set")</strong>
                </div>
                <div class="summary-line">
                    <span>Default address</span>
                    <strong>@(Model.User.DefaultAddress ?? "Not set")</strong>
                </div>
                <div class="summary-line">
                    <span>Role</span>
                    <strong>@Model.User.Role</strong>
                </div>
            </aside>
        </div>
        <div class="col-lg-8">
            <h2 class="section-heading">Receipt history</h2>
            @if (Model.Orders.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>No orders yet</h3>
                    <p>Signed-in checkouts will appear here with tax, payment status, and reorder context.</p>
                    <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Browse Menu</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Date</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th class="text-end">HST</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")</td>
                                    <td>@order.PaymentMethod</td>
                                    <td>@order.Status</td>
                                    <td class="text-end">@order.Tax.ToString("C")</td>
                                    <td class="text-end">@order.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
