@model ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Customer profile</p>
        <h1 class="page-title">@Model.User.FullName</h1>
    </div>
</section>

<section class="container py-4">
    @if (TempData["ProfileMessage"] is string message)
    {
        <div class="alert alert-info">@message</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <aside class="summary-panel">
                <h2>Account details</h2>
                <form asp-action="UpdateProfile" method="post" class="profile-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Profile.FullName"></label>
                        <input class="form-control" asp-for="Profile.FullName" />
                        <span class="text-danger" asp-validation-for="Profile.FullName"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.User.Email" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Profile.Phone"></label>
                        <input class="form-control" asp-for="Profile.Phone" />
                        <span class="text-danger" asp-validation-for="Profile.Phone"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Profile.DefaultAddress"></label>
                        <textarea class="form-control" asp-for="Profile.DefaultAddress" rows="3"></textarea>
                        <span class="text-danger" asp-validation-for="Profile.DefaultAddress"></span>
                    </div>
                    <div class="summary-line">
                        <span>Role</span>
                        <strong>@Model.User.Role</strong>
                    </div>
                    <button class="btn btn-primary w-100 mt-3" type="submit">Save Profile</button>
                </form>
            </aside>

            <aside class="summary-panel mt-4">
                <h2>Password</h2>
                <form asp-action="ChangePassword" method="post" class="profile-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Password.CurrentPassword"></label>
                        <input class="form-control" asp-for="Password.CurrentPassword" />
                        <span class="text-danger" asp-validation-for="Password.CurrentPassword"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Password.NewPassword"></label>
                        <input class="form-control" asp-for="Password.NewPassword" />
                        <span class="text-danger" asp-validation-for="Password.NewPassword"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Password.ConfirmNewPassword"></label>
                        <input class="form-control" asp-for="Password.ConfirmNewPassword" />
                        <span class="text-danger" asp-validation-for="Password.ConfirmNewPassword"></span>
                    </div>
                    <button class="btn btn-outline-dark w-100" type="submit">Change Password</button>
                </form>
            </aside>

            <aside class="summary-panel mt-4">
                <h2>Favorites</h2>
                @if (Model.FavoriteMenuItems.Count == 0)
                {
                    <p class="text-muted">Saved dishes will appear here for fast reordering.</p>
                    <a class="btn btn-outline-dark w-100" asp-controller="Menu" asp-action="Index">Browse Menu</a>
                }
                else
                {
                    <div class="favorite-list">
                        @foreach (var favorite in Model.FavoriteMenuItems)
                        {
                            <article class="favorite-row">
                                <div>
                                    <strong>@favorite.Name</strong>
                                    <span>@favorite.Price.ToString("C") - @favorite.AvailabilityStatus</span>
                                </div>
                                <div class="favorite-actions">
                                    <a class="btn btn-outline-dark btn-sm" asp-controller="Menu" asp-action="Details" asp-route-id="@favorite.Id">View</a>
                                    <form asp-action="RemoveFavorite" method="post">
                                        <input type="hidden" name="id" value="@favorite.Id" />
                                        <button class="btn btn-outline-danger btn-sm" type="submit">Remove</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }
            </aside>
        </div>
        <div class="col-lg-8">
            <h2 class="section-heading">Receipt history</h2>
            @if (Model.Orders.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>No orders yet</h3>
                    <p>Signed-in checkouts will appear here with tax, payment status, and reorder context.</p>
                    <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Browse Menu</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Date</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th></th>
                                <th class="text-end">HST</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")</td>
                                    <td>@order.PaymentMethod</td>
                                    <td>@order.Status</td>
                                    <td class="receipt-actions">
                                        <a class="btn btn-outline-dark btn-sm" asp-controller="Checkout" asp-action="Confirmation" asp-route-id="@order.Id">View</a>
                                        <form asp-controller="Checkout" asp-action="Reorder" method="post">
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <button class="btn btn-primary btn-sm" type="submit">Reorder</button>
                                        </form>
                                        @if (OrderStatusOptions.CanCustomerCancel(order.Status))
                                        {
                                            <form asp-action="CancelOrder" method="post">
                                                <input type="hidden" name="id" value="@order.Id" />
                                                <button class="btn btn-outline-danger btn-sm" type="submit">Cancel</button>
                                            </form>
                                        }
                                    </td>
                                    <td class="text-end">@order.Tax.ToString("C")</td>
                                    <td class="text-end">@order.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
