@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Administrator</p>
        <h1 class="page-title">Restaurant dashboard</h1>
    </div>
</section>

<section class="container py-4">
    @if (TempData["AdminMessage"] is string message)
    {
        <div class="alert alert-info">@message</div>
    }

    <div class="metric-grid">
        <div class="metric">
            <span>Menu items</span>
            <strong>@Model.MenuItems.Count</strong>
        </div>
        <div class="metric">
            <span>Receipts</span>
            <strong>@Model.ReceiptCount</strong>
        </div>
        <div class="metric">
            <span>Customers</span>
            <strong>@Model.CustomerCount</strong>
        </div>
        <div class="metric">
            <span>Total sales</span>
            <strong>@Model.TotalSales.ToString("C")</strong>
        </div>
        <div class="metric">
            <span>Tax collected</span>
            <strong>@Model.TotalTax.ToString("C")</strong>
        </div>
        <div class="metric">
            <span>Average order</span>
            <strong>@Model.AverageOrderValue.ToString("C")</strong>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="section-heading mb-0">Menu management</h2>
                <a class="btn btn-primary" asp-action="CreateMenuItem">Add Item</a>
            </div>
            <div class="list-panel">
                @foreach (var item in Model.MenuItems)
                {
                    <div class="list-row menu-admin-row">
                        <div>
                            <strong>@item.Name</strong>
                            <span>@item.Category - @item.EstimatedCalories calories - @(item.IsAvailable ? "Available" : "Unavailable")</span>
                        </div>
                        <div class="admin-actions">
                            <span>@item.Price.ToString("C")</span>
                            <a class="btn btn-outline-dark btn-sm" asp-action="EditMenuItem" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="DeleteMenuItem" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-8">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="section-heading mb-0">Sales reports</h2>
                <a class="btn btn-outline-dark btn-sm" asp-action="Index">Reset Filters</a>
            </div>

            <form asp-action="Index" method="get" class="report-filter">
                <div>
                    <label class="form-label" asp-for="DateFrom">From</label>
                    <input class="form-control" asp-for="DateFrom" type="date" />
                </div>
                <div>
                    <label class="form-label" asp-for="DateTo">To</label>
                    <input class="form-control" asp-for="DateTo" type="date" />
                </div>
                <div>
                    <label class="form-label" asp-for="PaymentMethod">Payment</label>
                    <select class="form-select" asp-for="PaymentMethod">
                        <option value="">All payments</option>
                        @foreach (var method in Model.PaymentMethods)
                        {
                            <option value="@method">@method</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" asp-for="OrderStatus">Status</label>
                    <select class="form-select" asp-for="OrderStatus">
                        <option value="">All statuses</option>
                        @foreach (var status in Model.OrderStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" asp-for="Search">Search</label>
                    <input class="form-control" asp-for="Search" placeholder="Receipt, customer, email" />
                </div>
                <button class="btn btn-primary" type="submit">Apply</button>
            </form>

            <div class="report-grid">
                <div class="summary-panel">
                    <h3>By payment type</h3>
                    @if (Model.PaymentBreakdown.Count == 0)
                    {
                        <p class="text-muted">No payment data for this filter.</p>
                    }
                    @foreach (var item in Model.PaymentBreakdown)
                    {
                        <div class="summary-line">
                            <span>@item.Label <small>@item.Count receipt(s)</small></span>
                            <strong>@item.Total.ToString("C")</strong>
                        </div>
                    }
                </div>
                <div class="summary-panel">
                    <h3>By order status</h3>
                    @if (Model.StatusBreakdown.Count == 0)
                    {
                        <p class="text-muted">No status data for this filter.</p>
                    }
                    @foreach (var item in Model.StatusBreakdown)
                    {
                        <div class="summary-line">
                            <span>@item.Label <small>@item.Count receipt(s)</small></span>
                            <strong>@item.Total.ToString("C")</strong>
                        </div>
                    }
                </div>
            </div>

            <h2 class="section-heading mt-4">Receipts</h2>
            @if (Model.Orders.Count == 0)
            {
                <div class="empty-state compact">
                    <h3>No receipts match this view</h3>
                    <p>Completed checkouts will appear here for the restaurant owner. Try clearing filters if you expected results.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Update</th>
                                <th></th>
                                <th>Type</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.CreatedAt.LocalDateTime.ToString("MMM d, yyyy")</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.PaymentMethod</td>
                                    <td>@order.Status</td>
                                    <td>
                                        <form asp-action="UpdateOrderStatus" method="post" class="status-form">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <select class="form-select form-select-sm" name="status" aria-label="Update @order.Id status">
                                                @foreach (var status in Model.AvailableOrderStatuses)
                                                {
                                                    <option value="@status" selected="@(status == order.Status)">@status</option>
                                                }
                                            </select>
                                            <button class="btn btn-outline-dark btn-sm" type="submit">Save</button>
                                        </form>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-dark btn-sm" asp-controller="Checkout" asp-action="Confirmation" asp-route-id="@order.Id">View</a>
                                    </td>
                                    <td>@order.OrderType</td>
                                    <td class="text-end">@order.Tax.ToString("C")</td>
                                    <td class="text-end">@order.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <h2 class="section-heading">Customers</h2>
        @if (Model.Customers.Count == 0)
        {
            <div class="empty-state compact">
                <h3>No registered customers yet</h3>
                <p>New account registrations will appear here with receipt history and contact details.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle customer-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>Default address</th>
                            <th class="text-end">Orders</th>
                            <th>Last order</th>
                            <th class="text-end">Lifetime spend</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.Customers)
                        {
                            <tr>
                                <td>
                                    <strong>@customer.FullName</strong>
                                    <span>@customer.Email</span>
                                </td>
                                <td>@(customer.Phone ?? "Not set")</td>
                                <td>@(customer.DefaultAddress ?? "Not set")</td>
                                <td class="text-end">@customer.OrderCount</td>
                                <td>@(customer.LastOrderAt?.LocalDateTime.ToString("MMM d, yyyy") ?? "No orders")</td>
                                <td class="text-end">@customer.TotalSpent.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
