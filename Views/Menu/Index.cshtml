@model IReadOnlyList<MenuItem>

@{
    ViewData["Title"] = "Menu";
    var categories = ViewBag.Categories as IReadOnlyList<string> ?? [];
    var selectedCategory = ViewBag.SelectedCategory as string;
}

<section class="page-band">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <p class="eyebrow">Menu</p>
                <h1 class="page-title">Browse dishes</h1>
            </div>
            <div class="btn-group" role="group" aria-label="Menu categories">
                <a class="btn @(string.IsNullOrWhiteSpace(selectedCategory) ? "btn-dark" : "btn-outline-dark")" asp-action="Index">All</a>
                @foreach (var category in categories)
                {
                    <a class="btn @(selectedCategory == category ? "btn-dark" : "btn-outline-dark")" asp-action="Index" asp-route-category="@category">@category</a>
                }
            </div>
        </div>
    </div>
</section>

<section class="container py-4">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="menu-card">
                    <div class="dish-art @item.AccentClass">
                        <span>@item.Category</span>
                    </div>
                    <div class="menu-card-body">
                        <div class="d-flex justify-content-between gap-3">
                            <h2>@item.Name</h2>
                            <strong>@item.Price.ToString("C")</strong>
                        </div>
                        <p>@item.Description</p>
                        <div class="dish-meta">
                            <span>@item.EstimatedCalories calories</span>
                            <span>@item.Ingredients.Count ingredients</span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-outline-dark flex-fill" asp-action="Details" asp-route-id="@item.Id">Details</a>
                            <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-primary w-100" type="submit">Add</button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</section>
