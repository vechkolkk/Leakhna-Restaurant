@model MenuIndexViewModel

@{
    ViewData["Title"] = "Menu";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Menu</p>
        <h1 class="page-title">Browse dishes</h1>
    </div>
</section>

<section class="container py-4">
    <form asp-action="Index" method="get" class="menu-filter">
        <div>
            <label class="form-label" asp-for="Search">Search</label>
            <input class="form-control" asp-for="Search" placeholder="Dish, ingredient, or flavor" />
        </div>
        <div>
            <label class="form-label" asp-for="Category">Category</label>
            <select class="form-select" asp-for="Category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <label class="filter-check">
            <input class="form-check-input" asp-for="AvailableOnly" />
            <span>Available only</span>
        </label>
        <button class="btn btn-primary" type="submit">Apply</button>
        <a class="btn btn-outline-dark" asp-action="Index">Reset</a>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state compact">
            <h2>No dishes match your search</h2>
            <p>Try a different category, ingredient, or availability setting.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-6 col-xl-4">
                    <article class="menu-card">
                        <div class="dish-art @item.AccentClass">
                            <span>@item.Category</span>
                        </div>
                        <div class="menu-card-body">
                            <div class="d-flex justify-content-between gap-3">
                                <h2>@item.Name</h2>
                                <strong>@item.Price.ToString("C")</strong>
                            </div>
                            <p>@item.Description</p>
                            <div class="dish-meta">
                                <span>@item.EstimatedCalories calories</span>
                                <span>@item.Ingredients.Count ingredients</span>
                                <span>@(item.IsAvailable ? "Available" : "Unavailable")</span>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <a class="btn btn-outline-dark flex-fill" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-primary w-100" type="submit" disabled="@(!item.IsAvailable)">Add</button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
