@model MenuIndexViewModel

@{
    ViewData["Title"] = "Menu";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Menu</p>
        <h1 class="page-title">Browse dishes</h1>
    </div>
</section>

<section class="container py-4">
    @if (TempData["CartMessage"] is string cartMessage)
    {
        <div class="alert alert-info">@cartMessage</div>
    }

    <form asp-action="Index" method="get" class="menu-filter">
        <div>
            <label class="form-label" asp-for="Search">Search</label>
            <input class="form-control" asp-for="Search" placeholder="Dish, ingredient, or flavor" />
        </div>
        <div>
            <label class="form-label" asp-for="Category">Category</label>
            <select class="form-select" asp-for="Category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <label class="filter-check">
            <input class="form-check-input" asp-for="AvailableOnly" />
            <span>Available only</span>
        </label>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <label class="filter-check">
                <input class="form-check-input" asp-for="FavoritesOnly" />
                <span>Favorites only</span>
            </label>
        }
        <button class="btn btn-primary" type="submit">Apply</button>
        <a class="btn btn-outline-dark" asp-action="Index">Reset</a>
        <details class="advanced-filter-panel">
            <summary>More filters</summary>
            <div class="advanced-filter-grid">
                <div>
                    <label class="form-label" asp-for="DietaryTag">Dietary</label>
                    <select class="form-select" asp-for="DietaryTag">
                        <option value="">Any diet</option>
                        @foreach (var tag in Model.DietaryTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" asp-for="AvoidAllergen">Avoid</label>
                    <select class="form-select" asp-for="AvoidAllergen">
                        <option value="">No allergen filter</option>
                        @foreach (var allergen in Model.Allergens)
                        {
                            <option value="@allergen">@allergen</option>
                        }
                    </select>
                </div>
            </div>
        </details>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state compact">
            <h2>No dishes match your search</h2>
            <p>Try a different category, ingredient, or availability setting.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                var isFavorite = Model.FavoriteMenuItemIds.Contains(item.Id);
                <div class="col-md-6 col-xl-4">
                    <article class="menu-card">
                        <div class="dish-art @item.AccentClass">
                            <span>@item.Category</span>
                        </div>
                        <div class="menu-card-body">
                            <div class="d-flex justify-content-between gap-3">
                                <h2>@item.Name</h2>
                                <strong>@item.Price.ToString("C")</strong>
                            </div>
                            <p>@item.Description</p>
                            <div class="dish-meta">
                                <span>@item.EstimatedCalories calories</span>
                                <span class="@(item.IsLimited ? "availability-pill limited" : item.IsOrderable ? "" : "availability-pill empty")">@item.AvailabilityStatus</span>
                            </div>
                            @if (item.DietaryTags.Count > 0)
                            {
                                <div class="tag-row">
                                    @foreach (var tag in item.DietaryTags.Take(2))
                                    {
                                        <span>@tag</span>
                                    }
                                </div>
                            }
                            <div class="d-flex gap-2 mt-3">
                                <a class="btn btn-outline-dark flex-fill" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-action="@(isFavorite ? "RemoveFavorite" : "AddFavorite")" method="post" class="flex-fill">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button class="btn btn-outline-dark w-100" type="submit">@(isFavorite ? "Saved" : "Save")</button>
                                    </form>
                                }
                                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-primary w-100" type="submit" disabled="@(!item.IsOrderable)">Add</button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
