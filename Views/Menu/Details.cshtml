@model MenuItem

@{
    ViewData["Title"] = Model.Name;
}

<section class="container py-5">
    <div class="row g-4 align-items-start">
        <div class="col-lg-5">
            <div class="dish-art detail-art @Model.AccentClass">
                <span>@Model.Category</span>
                <strong>@Model.Name</strong>
            </div>
        </div>
        <div class="col-lg-7">
            <p class="eyebrow">@Model.Category</p>
            <h1 class="page-title">@Model.Name</h1>
            <p class="lead">@Model.Description</p>
            <div class="detail-metrics">
                <span>@Model.Price.ToString("C")</span>
                <span>@Model.EstimatedCalories calories</span>
                <span class="@(Model.IsLimited ? "availability-pill limited" : Model.IsOrderable ? "" : "availability-pill empty")">@Model.AvailabilityStatus</span>
            </div>

            <h2 class="section-heading mt-4">Ingredients</h2>
            <ul class="ingredient-list">
                @foreach (var ingredient in Model.Ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>

            @if (Model.DietaryTags.Count > 0)
            {
                <h2 class="section-heading mt-4">Dietary notes</h2>
                <div class="tag-row detail-tags">
                    @foreach (var tag in Model.DietaryTags)
                    {
                        <span>@tag</span>
                    }
                </div>
            }

            @if (Model.Allergens.Count > 0)
            {
                <h2 class="section-heading mt-4">Allergen warnings</h2>
                <div class="tag-row detail-tags">
                    @foreach (var allergen in Model.Allergens)
                    {
                        <span class="allergen">Contains @allergen</span>
                    }
                </div>
            }

            @if (Model.IsOrderable)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="order-strip mt-4">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label class="form-label" for="quantity">Quantity</label>
                    <input class="form-control" id="quantity" name="quantity" type="number" value="1" min="1" max="20" />
                    <button class="btn btn-primary" type="submit">Add to Cart</button>
                    <a class="btn btn-outline-dark" asp-action="Index">Back to Menu</a>
                </form>
            }
            else
            {
                <div class="unavailable-panel mt-4">
                    <strong>This dish is currently unavailable.</strong>
                    <a class="btn btn-outline-dark" asp-action="Index" asp-route-availableOnly="true">Back to Menu</a>
                </div>
            }
        </div>
    </div>
</section>
