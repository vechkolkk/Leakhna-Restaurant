@model CartViewModel

@{
    ViewData["Title"] = "Cart";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Cart</p>
        <h1 class="page-title">Review your order</h1>
    </div>
</section>

<section class="container py-4">
    @if (TempData["CartMessage"] is string message)
    {
        <div class="alert alert-info">@message</div>
    }

    @if (Model.ItemCount == 0)
    {
        <div class="empty-state">
            <h2>Your cart is empty</h2>
            <p>Add a dish from the menu to start an order.</p>
            <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <div class="cart-items">
                    @foreach (var line in Model.Lines)
                    {
                        <article class="cart-item">
                            <div>
                                <p class="eyebrow">@line.MenuItem.Category</p>
                                <h2>@line.MenuItem.Name</h2>
                                <p>@line.MenuItem.Description</p>
                                <strong>@line.MenuItem.Price.ToString("C") each</strong>
                                <span class="stock-note">@line.MenuItem.InventoryStatus</span>
                            </div>
                            <form asp-action="Update" method="post" class="cart-item-controls">
                                <input type="hidden" name="id" value="@line.MenuItem.Id" />

                                <label class="form-label" for="quantity-@line.MenuItem.Id">Quantity</label>
                                <div class="quantity-stepper" data-quantity-stepper>
                                    <button class="btn btn-outline-dark btn-sm" type="button" data-step="-1">-</button>
                                    <input class="form-control" id="quantity-@line.MenuItem.Id" name="quantity" type="number" value="@line.Quantity" min="0" max="@line.MenuItem.StockQuantity" />
                                    <button class="btn btn-outline-dark btn-sm" type="button" data-step="1">+</button>
                                </div>

                                <label class="form-label" for="notes-@line.MenuItem.Id">Item notes</label>
                                <textarea class="form-control" id="notes-@line.MenuItem.Id" name="notes" rows="2" placeholder="No onions, extra sauce, allergy notes">@line.Notes</textarea>

                                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                                    <strong>@line.LineTotal.ToString("C")</strong>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-outline-dark btn-sm" type="submit">Update</button>
                                        <button class="btn btn-outline-danger btn-sm" type="submit" formaction="@Url.Action("Remove", "Cart", new { id = line.MenuItem.Id })">Remove</button>
                                    </div>
                                </div>
                            </form>
                        </article>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <aside class="summary-panel cart-summary-sticky">
                    <h2>Order summary</h2>
                    <div class="summary-line">
                        <span>Items</span>
                        <strong>@Model.ItemCount</strong>
                    </div>
                    <div class="summary-line">
                        <span>Subtotal</span>
                        <strong>@Model.Subtotal.ToString("C")</strong>
                    </div>
                    <div class="summary-line">
                        <span>HST (@Model.TaxRate.ToString("P0"))</span>
                        <strong>@Model.Tax.ToString("C")</strong>
                    </div>
                    <div class="summary-total grand-total">
                        <span>Total</span>
                        <strong>@Model.Total.ToString("C")</strong>
                    </div>
                    <a class="btn btn-primary w-100 mt-3" asp-controller="Checkout" asp-action="Index">Checkout</a>
                    <a class="btn btn-outline-dark w-100 mt-2" asp-controller="Menu" asp-action="Index">Add More</a>
                </aside>
            </div>
        </div>

        <form asp-action="Clear" method="post" class="mt-4">
            <button class="btn btn-outline-danger" type="submit">Clear Cart</button>
        </form>
    }
</section>
