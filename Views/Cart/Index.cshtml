@model CartViewModel

@{
    ViewData["Title"] = "Cart";
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Cart</p>
        <h1 class="page-title">Review your order</h1>
    </div>
</section>

<section class="container py-4">
    @if (TempData["CartMessage"] is string message)
    {
        <div class="alert alert-info">@message</div>
    }

    @if (Model.ItemCount == 0)
    {
        <div class="empty-state">
            <h2>Your cart is empty</h2>
            <p>Add a dish from the menu to start an order.</p>
            <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Browse Menu</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle cart-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <strong>@line.MenuItem.Name</strong>
                                <div class="text-muted">@line.MenuItem.Category</div>
                            </td>
                            <td>@line.MenuItem.Price.ToString("C")</td>
                            <td>
                                <form asp-action="Update" method="post" class="quantity-form">
                                    <input type="hidden" name="id" value="@line.MenuItem.Id" />
                                    <input class="form-control" name="quantity" type="number" value="@line.Quantity" min="0" max="20" />
                                    <button class="btn btn-outline-dark" type="submit">Update</button>
                                </form>
                            </td>
                            <td class="text-end">@line.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">Subtotal</th>
                        <th class="text-end">@Model.Subtotal.ToString("C")</th>
                    </tr>
                    <tr>
                        <th colspan="3">HST (@Model.TaxRate.ToString("P0"))</th>
                        <th class="text-end">@Model.Tax.ToString("C")</th>
                    </tr>
                    <tr>
                        <th colspan="3">Order total</th>
                        <th class="text-end">@Model.Total.ToString("C")</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-between">
            <form asp-action="Clear" method="post">
                <button class="btn btn-outline-danger" type="submit">Clear Cart</button>
            </form>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-dark" asp-controller="Menu" asp-action="Index">Add More</a>
                <a class="btn btn-primary" asp-controller="Checkout" asp-action="Index">Checkout</a>
            </div>
        </div>
    }
</section>
