@model Order

@{
    ViewData["Title"] = "Receipt";
}

<section class="container py-5">
    <div class="receipt">
        <div class="receipt-header">
            <div>
                <p class="eyebrow">Receipt</p>
                <h1>@Model.Id</h1>
            </div>
            <span class="status-pill">@Model.Status</span>
        </div>

        <dl class="receipt-meta">
            <div>
                <dt>Customer</dt>
                <dd>@Model.CustomerName</dd>
            </div>
            <div>
                <dt>Payment</dt>
                <dd>@Model.PaymentMethod - @Model.PaymentStatus</dd>
            </div>
            <div>
                <dt>Date</dt>
                <dd>@Model.CreatedAt.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</dd>
            </div>
            <div>
                <dt>Checkout</dt>
                <dd>@(Model.IsGuestCheckout ? "Guest" : "Registered")</dd>
            </div>
            <div>
                <dt>Order type</dt>
                <dd>@Model.OrderType</dd>
            </div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.PaymentSummary))
        {
            <p class="receipt-note">@Model.PaymentSummary</p>
        }

        <table class="table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>
                            @line.MenuItem.Name
                            @if (!string.IsNullOrWhiteSpace(line.Notes))
                            {
                                <div class="text-muted">@line.Notes</div>
                            }
                        </td>
                        <td>@line.Quantity</td>
                        <td class="text-end">@line.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2">Subtotal</th>
                    <th class="text-end">@Model.Subtotal.ToString("C")</th>
                </tr>
                <tr>
                    <th colspan="2">HST (@Model.TaxRate.ToString("P0"))</th>
                    <th class="text-end">@Model.Tax.ToString("C")</th>
                </tr>
                <tr>
                    <th colspan="2">Paid total</th>
                    <th class="text-end">@Model.Total.ToString("C")</th>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">Order Again</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Profile">View Profile</a>
            }
        </div>
    </div>
</section>
