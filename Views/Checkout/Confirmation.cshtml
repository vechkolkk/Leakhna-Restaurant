@model Order

@{
    ViewData["Title"] = "Receipt";
    var timeline = OrderStatusOptions.GetCustomerTimeline(Model.OrderType);
}

<section class="container py-5">
    @if (TempData["ReceiptMessage"] is string receiptMessage)
    {
        <div class="alert alert-info">@receiptMessage</div>
    }

    <div class="receipt">
        <div class="receipt-header">
            <div>
                <p class="eyebrow">Receipt</p>
                <h1>@Model.Id</h1>
            </div>
            <span class="status-pill">@Model.Status</span>
        </div>

        <dl class="receipt-meta">
            <div>
                <dt>Customer</dt>
                <dd>@Model.CustomerName</dd>
            </div>
            <div>
                <dt>Payment</dt>
                <dd>@Model.PaymentMethod - @Model.PaymentStatus</dd>
            </div>
            <div>
                <dt>Date</dt>
                <dd>@Model.CreatedAt.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</dd>
            </div>
            <div>
                <dt>Checkout</dt>
                <dd>@(Model.IsGuestCheckout ? "Guest" : "Registered")</dd>
            </div>
            <div>
                <dt>Order type</dt>
                <dd>@Model.OrderType</dd>
            </div>
            <div>
                <dt>Requested</dt>
                <dd>@(Model.FulfillmentTiming == "Scheduled" && Model.RequestedFulfillmentAt.HasValue ? Model.RequestedFulfillmentAt.Value.ToString("MMM d, yyyy h:mm tt") : "ASAP")</dd>
            </div>
            <div>
                <dt>Estimated ready</dt>
                <dd>@(Model.EstimatedReadyAt?.ToString("MMM d, yyyy h:mm tt") ?? $"{Model.EstimatedPrepMinutes} min")</dd>
            </div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.PaymentSummary))
        {
            <p class="receipt-note">@Model.PaymentSummary</p>
        }

        <section class="status-timeline" aria-label="Order status timeline">
            @foreach (var step in timeline)
            {
                var isComplete = OrderStatusOptions.IsTimelineStepComplete(Model.Status, step, Model.OrderType);
                var isCurrent = Model.Status == step || (Model.Status == "Awaiting Verification" && step == "Paid");
                <div class="status-step @(isComplete ? "complete" : string.Empty) @(isCurrent ? "current" : string.Empty)">
                    <span></span>
                    <strong>@step</strong>
                </div>
            }
            @if (Model.Status == "Cancelled")
            {
                <div class="status-step cancelled current">
                    <span></span>
                    <strong>Cancelled</strong>
                </div>
            }
        </section>

        <div class="receipt-detail-grid">
            <div>
                <h2>Customer</h2>
                <p>@Model.CustomerName</p>
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <p>@Model.Email</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <p>@Model.Phone</p>
                }
            </div>
            <div>
                <h2>Fulfillment</h2>
                <p>@Model.OrderType</p>
                <p>@(Model.FulfillmentTiming == "Scheduled" && Model.RequestedFulfillmentAt.HasValue ? Model.RequestedFulfillmentAt.Value.ToString("MMM d, yyyy h:mm tt") : "ASAP")</p>
                <p>@Model.EstimatedPrepMinutes min estimate</p>
                @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddress))
                {
                    <p>@Model.DeliveryAddress</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p>@Model.Notes</p>
                }
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>
                            @line.MenuItem.Name
                            @if (!string.IsNullOrWhiteSpace(line.Notes))
                            {
                                <div class="text-muted">@line.Notes</div>
                            }
                        </td>
                        <td>@line.Quantity</td>
                        <td class="text-end">@line.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2">Subtotal</th>
                    <th class="text-end">@Model.Subtotal.ToString("C")</th>
                </tr>
                @if (Model.Discount > 0)
                {
                    <tr class="discount-line">
                        <th colspan="2">
                            Promo @Model.DiscountCode
                            @if (!string.IsNullOrWhiteSpace(Model.DiscountLabel))
                            {
                                <span>@Model.DiscountLabel</span>
                            }
                        </th>
                        <th class="text-end">-@Model.Discount.ToString("C")</th>
                    </tr>
                }
                <tr>
                    <th colspan="2">HST (@Model.TaxRate.ToString("P0"))</th>
                    <th class="text-end">@Model.Tax.ToString("C")</th>
                </tr>
                <tr>
                    <th colspan="2">Paid total</th>
                    <th class="text-end">@Model.Total.ToString("C")</th>
                </tr>
            </tfoot>
        </table>

        <div class="d-flex flex-wrap gap-2 receipt-actions-bar">
            <button class="btn btn-outline-dark" type="button" onclick="window.print()">Print Receipt</button>
            <form asp-action="Reorder" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-primary" type="submit">Order Again</button>
            </form>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (OrderStatusOptions.CanCustomerCancel(Model.Status))
                {
                    <form asp-action="Cancel" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-outline-danger" type="submit">Cancel Order</button>
                    </form>
                }
                <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Profile">View Profile</a>
            }
        </div>
    </div>
</section>
