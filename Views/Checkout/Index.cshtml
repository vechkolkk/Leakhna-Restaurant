@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as CartViewModel ?? new CartViewModel();
    var paymentMethods = ViewBag.PaymentMethods as IReadOnlyList<string> ?? [];
    var orderTypes = ViewBag.OrderTypes as IReadOnlyList<string> ?? [];
}

<section class="page-band">
    <div class="container py-4">
        <p class="eyebrow">Checkout</p>
        <h1 class="page-title">Complete your order</h1>
    </div>
</section>

<section class="container py-4">
    <div class="row g-4">
        <div class="col-lg-7">
            <form asp-action="Index" method="post" class="checkout-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label"></label>
                        <input asp-for="CustomerName" class="form-control" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            @foreach (var method in paymentMethods)
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OrderType" class="form-label"></label>
                        <select asp-for="OrderType" class="form-select" data-order-type>
                            @foreach (var orderType in orderTypes)
                            {
                                <option value="@orderType">@orderType</option>
                            }
                        </select>
                        <span asp-validation-for="OrderType" class="text-danger"></span>
                    </div>
                    <div class="col-12 payment-panel" data-payment-panel="card">
                        <h2 class="section-heading">Card details</h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CardholderName" class="form-label"></label>
                                <input asp-for="CardholderName" class="form-control" autocomplete="cc-name" />
                                <span asp-validation-for="CardholderName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CardNumber" class="form-label"></label>
                                <input asp-for="CardNumber" class="form-control" autocomplete="cc-number" inputmode="numeric" />
                                <span asp-validation-for="CardNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CardExpiry" class="form-label"></label>
                                <input asp-for="CardExpiry" class="form-control" autocomplete="cc-exp" placeholder="MM/YY" />
                                <span asp-validation-for="CardExpiry" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CardCvv" class="form-label"></label>
                                <input asp-for="CardCvv" class="form-control" autocomplete="cc-csc" inputmode="numeric" />
                                <span asp-validation-for="CardCvv" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 payment-panel" data-payment-panel="paypal">
                        <h2 class="section-heading">PayPal details</h2>
                        <label asp-for="PayPalEmail" class="form-label"></label>
                        <input asp-for="PayPalEmail" class="form-control" />
                        <span asp-validation-for="PayPalEmail" class="text-danger"></span>
                    </div>
                    <div class="col-12 payment-panel" data-payment-panel="etransfer">
                        <h2 class="section-heading">E-transfer verification</h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ETransferSenderName" class="form-label"></label>
                                <input asp-for="ETransferSenderName" class="form-control" />
                                <span asp-validation-for="ETransferSenderName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ETransferReference" class="form-label"></label>
                                <input asp-for="ETransferReference" class="form-control" />
                                <span asp-validation-for="ETransferReference" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 delivery-panel">
                        <label asp-for="DeliveryAddress" class="form-label"></label>
                        <input asp-for="DeliveryAddress" class="form-control" />
                        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FulfillmentTiming" class="form-label"></label>
                        <select asp-for="FulfillmentTiming" class="form-select" data-fulfillment-timing>
                            <option value="ASAP">As soon as possible</option>
                            <option value="Scheduled">Schedule for later</option>
                        </select>
                        <span asp-validation-for="FulfillmentTiming" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 scheduled-panel">
                        <label asp-for="RequestedFulfillmentAt" class="form-label"></label>
                        <input asp-for="RequestedFulfillmentAt" class="form-control" type="datetime-local" />
                        <span asp-validation-for="RequestedFulfillmentAt" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsGuestCheckout" class="form-check-input" />
                            <label asp-for="IsGuestCheckout" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">Place Order</button>
                    <a class="btn btn-outline-dark" asp-controller="Cart" asp-action="Index">Back to Cart</a>
                </div>
            </form>
        </div>
        <div class="col-lg-5">
            <aside class="summary-panel">
                <h2>Order summary</h2>
                @foreach (var line in cart.Lines)
                {
                    <div class="summary-line">
                        <span>
                            @line.Quantity x @line.MenuItem.Name
                            @if (!string.IsNullOrWhiteSpace(line.Notes))
                            {
                                <small>@line.Notes</small>
                            }
                            <small>@line.MenuItem.AvailabilityStatus</small>
                        </span>
                        <strong>@line.LineTotal.ToString("C")</strong>
                    </div>
                }
                <div class="summary-total">
                    <span>Subtotal</span>
                    <strong>@cart.Subtotal.ToString("C")</strong>
                </div>
                <div class="summary-total">
                    <span>HST (@cart.TaxRate.ToString("P0"))</span>
                    <strong>@cart.Tax.ToString("C")</strong>
                </div>
                <div class="summary-total grand-total">
                    <span>Total</span>
                    <strong>@cart.Total.ToString("C")</strong>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const paymentSelect = document.querySelector('[name="PaymentMethod"]');
        const orderTypeSelect = document.querySelector('[data-order-type]');
        const fulfillmentTimingSelect = document.querySelector('[data-fulfillment-timing]');
        const panels = document.querySelectorAll('[data-payment-panel]');
        const deliveryPanel = document.querySelector('.delivery-panel');
        const scheduledPanel = document.querySelector('.scheduled-panel');

        function syncCheckoutPanels() {
            const method = paymentSelect.value;
            panels.forEach(panel => panel.hidden = true);

            if (method === 'Credit Card' || method === 'Debit Card') {
                document.querySelector('[data-payment-panel="card"]').hidden = false;
            }

            if (method === 'PayPal') {
                document.querySelector('[data-payment-panel="paypal"]').hidden = false;
            }

            if (method === 'E-Transfer') {
                document.querySelector('[data-payment-panel="etransfer"]').hidden = false;
            }

            deliveryPanel.hidden = orderTypeSelect.value !== 'Delivery';
            scheduledPanel.hidden = fulfillmentTimingSelect.value !== 'Scheduled';
        }

        paymentSelect.addEventListener('change', syncCheckoutPanels);
        orderTypeSelect.addEventListener('change', syncCheckoutPanels);
        fulfillmentTimingSelect.addEventListener('change', syncCheckoutPanels);
        syncCheckoutPanels();
    </script>
}
